{
  "id": "com.memomind.hello-page",
  "name": "hello-page",
  "version": "0.1.0",
  "entry": "index.html",
  "bridgeVersion": "2.0",
  "permissions": [
    {
      "name": "display",
      "required": true,
      "reason": "Render this plugin's page on the glasses"
    },
    {
      "name": "device.events",
      "required": true,
      "reason": "React to the glasses button and head gestures",
      "scope": {
        "types": ["button", "imuGesture", "connection"]
      }
    },
    {
      "name": "device.info",
      "required": false
    },
    {
      "name": "storage",
      "required": false
    }
  ],
  "deviceRequirements": {
    "preferredPluginId": "com.gm.example.web-bridge",
    "protocols": [
      { "id": "gm.scene", "minVersion": "1.0" },
      { "id": "gm.device-events", "minVersion": "1.0" }
    ]
  },
  "schemaVersion": 2,
  "permissionPolicyVersion": 1
}
